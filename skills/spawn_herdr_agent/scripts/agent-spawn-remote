#!/usr/bin/env bash
set -euo pipefail

# agent-spawn-remote — Portable POSIX client for Herdr multi-machine dispatch
# Invokes local and remote Herdr CLI commands directly via SSH forwarding.

HERDR_BIN="${HERDR_BIN_PATH:-$(command -v herdr || true)}"
if [ -z "$HERDR_BIN" ]; then
  for p in "$HOME/.local/bin/herdr" "$HOME/.nix-profile/bin/herdr" "/usr/local/bin/herdr" "/run/current-system/sw/bin/herdr"; do
    if [ -x "$p" ]; then
      HERDR_BIN="$p"
      break
    fi
  done
fi

if [ -z "$HERDR_BIN" ]; then
  echo "Error: 'herdr' executable not found on PATH or standard locations." >&2
  echo "Install Herdr via: curl -fsSL https://herdr.dev/install | sh" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OVERVIEW_SCRIPT="$SCRIPT_DIR/../bin/agents-overview.py"

TARGET_MACHINE=""

usage() {
  cat <<EOF
Usage: agent-spawn-remote [--machine <target>] <command> [options]

Commands:
  list machines                  List configured local & remote SSH machines
  list agents                    List active agents across machines
  list panes                     List panes on target machine
  list workspaces                List workspaces on target machine
  status                         Check server status on target machine
  spawn [options]                Split pane and start an agent with prompt
  prompt <target> <text> [--wait] Inject prompt into active agent
  read <target> [--lines N]      Read output from agent
  keys <target> <keys>           Send keystrokes to agent (e.g. ctrl+c)
  close <target>                 Close agent or pane

Options:
  --machine, --node <name>       Target machine label or ID (default: local)
  -h, --help                     Show this help message
EOF
  exit 1
}

run_herdr() {
  if [ -n "$TARGET_MACHINE" ] && [ "$TARGET_MACHINE" != "local" ] && [ "$TARGET_MACHINE" != "localhost" ]; then
    "$HERDR_BIN" --machine "$TARGET_MACHINE" "$@"
  else
    "$HERDR_BIN" "$@"
  fi
}

# Parse global options
while [[ $# -gt 0 ]]; do
  case "$1" in
    --machine|--node)
      TARGET_MACHINE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    *)
      break
      ;;
  esac
done

if [ $# -eq 0 ]; then
  usage
fi

CMD="$1"
shift

case "$CMD" in
  list)
    SUBCMD="${1:-}"
    shift || true
    case "$SUBCMD" in
      machines)
        "$HERDR_BIN" machine list "$@"
        ;;
      agents)
        if [ -n "$TARGET_MACHINE" ]; then
          run_herdr agent list "$@"
        elif [ -f "$OVERVIEW_SCRIPT" ]; then
          python3 "$OVERVIEW_SCRIPT" "$@"
        else
          "$HERDR_BIN" agent list "$@"
        fi
        ;;
      panes)
        run_herdr pane list "$@"
        ;;
      workspaces)
        run_herdr workspace list "$@"
        ;;
      *)
        echo "Unknown list subcommand: $SUBCMD" >&2
        echo "Valid subcommands: machines, agents, panes, workspaces" >&2
        exit 1
        ;;
    esac
    ;;

  status)
    run_herdr status server "$@"
    ;;

  spawn)
    NAME=""
    KIND="claude"
    PROMPT=""
    PANE=""
    DIRECTION="right"
    CWD=""
    WAIT=false

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --name)
          NAME="$2"
          shift 2
          ;;
        --kind)
          KIND="$2"
          shift 2
          ;;
        --prompt)
          PROMPT="$2"
          shift 2
          ;;
        --pane)
          PANE="$2"
          shift 2
          ;;
        --direction)
          DIRECTION="$2"
          shift 2
          ;;
        --cwd|--workspace)
          CWD="$2"
          shift 2
          ;;
        --wait)
          WAIT=true
          shift
          ;;
        *)
          shift
          ;;
      esac
    done

    if [ -z "$PROMPT" ]; then
      echo "Error: --prompt is required for spawn" >&2
      exit 1
    fi

    if [ -z "$NAME" ]; then
      NAME="agent-$(head -c 4 /dev/urandom | xxd -p 2>/dev/null || echo "$$")"
    fi

    # 1. Split pane if not specified
    if [ -z "$PANE" ]; then
      SPLIT_CMD=(pane split --direction "$DIRECTION")
      if [ -n "$CWD" ]; then
        SPLIT_CMD+=(--cwd "$CWD")
      fi
      PANE_OUTPUT=$(run_herdr "${SPLIT_CMD[@]}")
      # Extract pane_id if JSON returned
      if echo "$PANE_OUTPUT" | grep -q '"pane_id"'; then
        PANE=$(echo "$PANE_OUTPUT" | jq -r '.result.pane_id // empty' 2>/dev/null || true)
      fi
      if [ -z "$PANE" ]; then
        PANE=$(echo "$PANE_OUTPUT" | tr -d '\r\n')
      fi
    fi

    # 2. Start agent
    run_herdr agent start "$NAME" --kind "$KIND" --pane "$PANE"

    # 3. Prompt agent
    PROMPT_CMD=(agent prompt "$NAME" "$PROMPT")
    if [ "$WAIT" = true ]; then
      PROMPT_CMD+=(--wait)
    fi
    run_herdr "${PROMPT_CMD[@]}"
    ;;

  prompt)
    TARGET="${1:-}"
    shift || true
    PROMPT_TEXT="${1:-}"
    shift || true
    if [ -z "$TARGET" ] || [ -z "$PROMPT_TEXT" ]; then
      echo "Usage: agent-spawn-remote prompt <target> <prompt> [--wait]" >&2
      exit 1
    fi
    run_herdr agent prompt "$TARGET" "$PROMPT_TEXT" "$@"
    ;;

  read)
    TARGET="${1:-}"
    shift || true
    if [ -z "$TARGET" ]; then
      echo "Usage: agent-spawn-remote read <target> [--lines N]" >&2
      exit 1
    fi
    run_herdr agent read "$TARGET" "$@"
    ;;

  keys)
    TARGET="${1:-}"
    shift || true
    KEYS="${1:-}"
    shift || true
    if [ -z "$TARGET" ] || [ -z "$KEYS" ]; then
      echo "Usage: agent-spawn-remote keys <target> <keystrokes>" >&2
      exit 1
    fi
    run_herdr agent send-keys "$TARGET" "$KEYS" "$@"
    ;;

  close)
    TARGET="${1:-}"
    shift || true
    if [ -z "$TARGET" ]; then
      echo "Usage: agent-spawn-remote close <target>" >&2
      exit 1
    fi
    run_herdr pane close "$TARGET" "$@"
    ;;

  *)
    echo "Unknown command: $CMD" >&2
    usage
    ;;
esac
