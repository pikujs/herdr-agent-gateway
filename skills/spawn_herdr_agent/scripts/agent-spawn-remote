#!/usr/bin/env bash
set -euo pipefail

# agent-spawn-remote — Portable POSIX client for Herdr Agent Gateway
# Resolves machine profiles from herdr_nodes.json and executes remote actions.

NODES_FILE=""
NODE_ID=""
HERDR_ENDPOINT=""
HERDR_TOKEN=""
HERDR_SSH_KEY=""

# --- Node Profile Discovery ---
find_nodes_file() {
  if [ -n "$NODES_FILE" ] && [ -f "$NODES_FILE" ]; then
    echo "$NODES_FILE"
    return 0
  fi
  if [ -n "${HERDR_NODES_PATH:-}" ] && [ -f "${HERDR_NODES_PATH}" ]; then
    echo "$HERDR_NODES_PATH"
    return 0
  fi
  if [ -n "${HERDR_AGENT_NODES_PATH:-}" ] && [ -f "${HERDR_AGENT_NODES_PATH}" ]; then
    echo "$HERDR_AGENT_NODES_PATH"
    return 0
  fi
  local candidates=(
    "$HOME/.config/herdr/plugins/config/herdr-remote-gateway/herdr_nodes.json"
    "$HOME/.config/herdr-agent-gateway/herdr_nodes.json"
    "$HOME/.config/herdr_nodes.json"
    "$HOME/.config/herdr/plugins/config/herdr-remote-gateway/agent_nodes.json"
    "$HOME/.config/herdr-agent-gateway/agent_nodes.json"
    "$HOME/.config/agent_nodes.json"
  )
  for c in "${candidates[@]}"; do
    if [ -f "$c" ]; then
      echo "$c"
      return 0
    fi
  done
  echo ""
}

resolve_node() {
  local file
  file=$(find_nodes_file)

  # Check direct environment overrides
  if [ -n "${HERDR_GATEWAY_ENDPOINT:-}" ]; then
    HERDR_ENDPOINT="${HERDR_GATEWAY_ENDPOINT%/}"
    HERDR_TOKEN="${HERDR_GATEWAY_TOKEN:-}"
    return 0
  fi

  if [ -z "$file" ] || [ ! -f "$file" ]; then
    HERDR_ENDPOINT="http://127.0.0.1:9480"
    if [ -f "$HOME/.config/herdr/plugins/config/herdr-remote-gateway/gateway.token" ]; then
      HERDR_TOKEN=$(cat "$HOME/.config/herdr/plugins/config/herdr-remote-gateway/gateway.token" | tr -d '\r\n')
    fi
    return 0
  fi

  # Determine target node ID
  local target_node="$NODE_ID"
  if [ -z "$target_node" ]; then
    target_node=$(jq -r '.default_node // empty' "$file" 2>/dev/null || true)
  fi

  # If default node is missing or failing, evaluate fallback_order
  if [ -z "$target_node" ]; then
    local fallbacks
    fallbacks=$(jq -r '.fallback_order[]? // empty' "$file" 2>/dev/null || true)
    for fb in $fallbacks; do
      local ep
      ep=$(jq -r ".nodes[\"$fb\"].endpoint // empty" "$file" 2>/dev/null || true)
      if [ -n "$ep" ]; then
        if curl -s -f -m 2 "$ep/api/v1/health" >/dev/null 2>&1; then
          target_node="$fb"
          break
        fi
      fi
    done
  fi

  # Fall back to first available node in registry
  if [ -z "$target_node" ]; then
    target_node=$(jq -r '.nodes | keys[0] // empty' "$file" 2>/dev/null || true)
  fi

  if [ -z "$target_node" ]; then
    HERDR_ENDPOINT="http://127.0.0.1:9480"
    return 0
  fi

  HERDR_ENDPOINT=$(jq -r ".nodes[\"$target_node\"].endpoint // \"http://127.0.0.1:9480\"" "$file")
  HERDR_ENDPOINT="${HERDR_ENDPOINT%/}"

  local token_field
  token_field=$(jq -r ".nodes[\"$target_node\"].auth_token // empty" "$file")
  if [[ "$token_field" =~ ^env:(.*)$ ]]; then
    local env_var="${BASH_REMATCH[1]}"
    HERDR_TOKEN="${!env_var:-}"
  elif [ -n "$token_field" ]; then
    HERDR_TOKEN="$token_field"
  fi

  local ssh_key_field
  ssh_key_field=$(jq -r ".nodes[\"$target_node\"].ssh_key.private_key_path // empty" "$file")
  if [ -n "$ssh_key_field" ]; then
    HERDR_SSH_KEY="${ssh_key_field/#\~/$HOME}"
  fi

  if [ -z "$HERDR_TOKEN" ] && [ -z "$HERDR_SSH_KEY" ]; then
    local local_token_file="$HOME/.config/herdr/plugins/config/herdr-remote-gateway/gateway.token"
    if [ -f "$local_token_file" ]; then
      HERDR_TOKEN=$(cat "$local_token_file" | tr -d '\r\n')
    fi
  fi
}

send_request() {
  local method="$1"
  local path="$2"
  local body="${3:-}"

  local url="${HERDR_ENDPOINT}${path}"
  local headers=("-H" "Content-Type: application/json")

  if [ -n "$HERDR_TOKEN" ]; then
    headers+=("-H" "Authorization: Bearer $HERDR_TOKEN")
  elif [ -n "$HERDR_SSH_KEY" ] && [ -f "$HERDR_SSH_KEY" ]; then
    # SSH Signature authentication
    local timestamp
    timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local digest
    digest=$(printf "%s" "$body" | openssl dgst -sha256 -binary | base64)

    # Compute key fingerprint
    local key_id
    key_id=$(ssh-keygen -l -f "$HERDR_SSH_KEY" 2>/dev/null | awk '{print $2}' || true)

    local canonical
    canonical=$(printf "%s\n%s\n%s\n%s" "$method" "$path" "$timestamp" "$digest")
    local sig_base64
    sig_base64=$(printf "%s" "$canonical" | openssl dgst -sha256 -sign "$HERDR_SSH_KEY" 2>/dev/null | base64 | tr -d '\n' || true)

    if [ -n "$sig_base64" ] && [ -n "$key_id" ]; then
      headers+=(
        "-H" "X-Herdr-Key-Id: $key_id"
        "-H" "X-Herdr-Timestamp: $timestamp"
        "-H" "X-Herdr-Digest: SHA-256=$digest"
        "-H" "X-Herdr-Signature: $sig_base64"
        "-H" "Authorization: SSH-Signature keyId=\"$key_id\",timestamp=\"$timestamp\",signature=\"$sig_base64\""
      )
    fi
  fi

  if [ "$method" = "GET" ]; then
    curl -s -S "${headers[@]}" "$url"
  else
    curl -s -S -X "$method" "${headers[@]}" -d "$body" "$url"
  fi
}

# --- Command Handlers ---
cmd_health() {
  send_request "GET" "/api/v1/health"
}

cmd_list() {
  local target="${1:-panes}"
  case "$target" in
    workspaces|panes|agents)
      local snapshot
      snapshot=$(send_request "GET" "/api/v1/snapshot")
      echo "$snapshot" | jq ".result.$target // .result.panes // ."
      ;;
    *)
      echo "Usage: agent-spawn-remote list [workspaces|panes|agents]" >&2
      exit 2
      ;;
  esac
}

cmd_read() {
  local pane_id=""
  local lines=100
  local format="text"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lines) lines="$2"; shift 2 ;;
      --format) format="$2"; shift 2 ;;
      *) pane_id="$1"; shift ;;
    esac
  done

  if [ -z "$pane_id" ]; then
    echo "Usage: agent-spawn-remote read <pane_id> [--lines N] [--format text|ansi]" >&2
    exit 2
  fi

  send_request "GET" "/api/v1/panes/$pane_id?lines=$lines&format=$format"
}

cmd_spawn() {
  local kind=""
  local name=""
  local prompt=""
  local workspace=""
  local direction="right"
  local cwd=""
  local sync="true"
  local approval_mode=""
  local agent_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --kind) kind="$2"; shift 2 ;;
      --name) name="$2"; shift 2 ;;
      --prompt) prompt="$2"; shift 2 ;;
      --workspace) workspace="$2"; shift 2 ;;
      --direction) direction="$2"; shift 2 ;;
      --cwd) cwd="$2"; shift 2 ;;
      --approval-mode) approval_mode="$2"; shift 2 ;;
      --yolo) approval_mode="yolo"; shift ;;
      --arg) agent_args+=("$2"); shift 2 ;;
      --async) sync="false"; shift ;;
      *) echo "Unknown spawn argument: $1" >&2; exit 2 ;;
    esac
  done

  if [ -z "$kind" ] || [ -z "$name" ]; then
    echo "Usage: agent-spawn-remote spawn --kind <kind> --name <name> [--prompt <text>] [--workspace <ws>] [--cwd <path>] [--yolo] [--approval-mode yolo|off|prompt] [--arg <extra_arg>] [--async]" >&2
    exit 2
  fi

  local args_json="[]"
  if [ ${#agent_args[@]} -gt 0 ]; then
    args_json=$(printf '%s\n' "${agent_args[@]}" | jq -R . | jq -s .)
  fi

  local payload
  payload=$(jq -n \
    --arg kind "$kind" \
    --arg name "$name" \
    --arg prompt "$prompt" \
    --arg workspace "$workspace" \
    --arg direction "$direction" \
    --arg cwd "$cwd" \
    --arg approval_mode "$approval_mode" \
    --argjson agent_args "$args_json" \
    '{
      agent_kind: $kind,
      agent_name: $name,
      prompt: (if $prompt == "" then null else $prompt end),
      workspace: (if $workspace == "" then null else $workspace end),
      direction: $direction,
      cwd: (if $cwd == "" then null else $cwd end),
      focus: false,
      approval_mode: (if $approval_mode == "" then null else $approval_mode end),
      agent_args: (if ($agent_args | length) == 0 then null else $agent_args end)
    }')

  send_request "POST" "/api/v1/agents/spawn?sync=$sync" "$payload"
}

cmd_prompt() {
  local agent=""
  local prompt_text=""
  local wait="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent) agent="$2"; shift 2 ;;
      --wait) wait="true"; shift ;;
      *)
        if [ -z "$prompt_text" ]; then
          prompt_text="$1"
        else
          prompt_text="$prompt_text $1"
        fi
        shift
        ;;
    esac
  done

  if [ -z "$agent" ] || [ -z "$prompt_text" ]; then
    echo "Usage: agent-spawn-remote prompt --agent <name> <prompt_text> [--wait]" >&2
    exit 2
  fi

  local payload
  payload=$(jq -n \
    --arg agent "$agent" \
    --arg prompt "$prompt_text" \
    --argjson wait "$wait" \
    '{agent_name: $agent, prompt: $prompt, wait: $wait}')

  send_request "POST" "/api/v1/agents/prompt" "$payload"
}

cmd_keys() {
  local pane_id="${1:-}"
  shift || true
  if [ -z "$pane_id" ] || [ $# -eq 0 ]; then
    echo "Usage: agent-spawn-remote keys <pane_id> <key1> [key2...]" >&2
    exit 2
  fi

  local keys_json
  keys_json=$(printf '%s\n' "$@" | jq -R . | jq -s .)
  local payload
  payload=$(jq -n --argjson keys "$keys_json" '{keys: $keys}')

  send_request "POST" "/api/v1/panes/$pane_id/keys" "$payload"
}

cmd_close() {
  local pane_id="${1:-}"
  if [ -z "$pane_id" ]; then
    echo "Usage: agent-spawn-remote close <pane_id>" >&2
    exit 2
  fi

  send_request "POST" "/api/v1/panes/$pane_id/close" "{}"
}

# --- CLI Dispatcher ---
main() {
  # Global options
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --nodes-file) NODES_FILE="$2"; shift 2 ;;
      --node) NODE_ID="$2"; shift 2 ;;
      --endpoint) HERDR_ENDPOINT="$2"; shift 2 ;;
      --token) HERDR_TOKEN="$2"; shift 2 ;;
      *) break ;;
    esac
  done

  resolve_node

  local subcommand="${1:-help}"
  shift || true

  case "$subcommand" in
    health) cmd_health ;;
    list) cmd_list "$@" ;;
    read) cmd_read "$@" ;;
    spawn) cmd_spawn "$@" ;;
    prompt) cmd_prompt "$@" ;;
    keys) cmd_keys "$@" ;;
    close) cmd_close "$@" ;;
    help|--help|-h)
      echo "Herdr Agent Gateway Client CLI"
      echo ""
      echo "Commands:"
      echo "  health                                Check gateway connectivity"
      echo "  list [workspaces|panes|agents]        Inspect remote Herdr state"
      echo "  read <pane_id> [--lines N]            Read terminal output"
      echo "  spawn --kind <k> --name <n> [opts]    Create tab and start agent (--yolo for auto-approve)"
      echo "  prompt --agent <n> <text> [--wait]    Inject instruction prompt"
      echo "  keys <pane_id> <key...>               Send keys (ctrl+c, esc)"
      echo "  close <pane_id>                       Close pane"
      echo ""
      echo "Global Options:"
      echo "  --node <id>        Target node profile in herdr_nodes.json"
      echo "  --nodes-file <path> Custom path to herdr_nodes.json"
      echo "  --endpoint <url>   Direct gateway URL override"
      echo "  --token <token>    Direct Bearer token override"
      ;;
    *)
      echo "Unknown command: $subcommand. Run with --help for usage." >&2
      exit 2
      ;;
  esac
}

main "$@"
